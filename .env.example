# Copy to .env and adjust as needed. Read by docker-compose.yml and the backend.

# --- Postgres container (docker-compose) ---
POSTGRES_USER=nutrition
POSTGRES_PASSWORD=nutrition
POSTGRES_DB=nutrition_tracker
POSTGRES_PORT=5432

# --- Backend ---
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nutrition
DB_PASSWORD=nutrition
DB_NAME=nutrition_tracker
DB_LOGGING=false

# --- Frontend (Vite dev server proxies /api/* here) ---
VITE_API_PROXY_TARGET=http://localhost:3000
